{
  "root": "root",
  "state": {
    "tom": true,
    "sara": true,
    "priya": true,
    "mo": false,
    "at": "6pm"
  },
  "elements": {
    "root": {
      "type": "Stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "who",
        "acts"
      ]
    },
    "who": {
      "type": "Card",
      "props": {
        "title": "Who gets a reminder",
        "description": "Tomorrow, Saturday 28 Sep"
      },
      "children": [
        "t1",
        "t2",
        "t3",
        "t4",
        "moNote",
        "when"
      ]
    },
    "t1": {
      "type": "Toggle",
      "props": {
        "label": "Tom Hale",
        "hint": "10:00 · Cut",
        "checked": {
          "$bindState": "/tom"
        }
      }
    },
    "t2": {
      "type": "Toggle",
      "props": {
        "label": "Sara Lin",
        "hint": "11:30 · Cut & blow-dry",
        "checked": {
          "$bindState": "/sara"
        }
      }
    },
    "t3": {
      "type": "Toggle",
      "props": {
        "label": "Priya Shah",
        "hint": "14:30 · Colour",
        "checked": {
          "$bindState": "/priya"
        }
      }
    },
    "t4": {
      "type": "Toggle",
      "props": {
        "label": "Mo Reid",
        "hint": "16:45 · Beard trim",
        "checked": {
          "$bindState": "/mo"
        }
      }
    },
    "moNote": {
      "type": "Text",
      "props": {
        "text": "Mo has confirmed on his own for his last 6 visits."
      },
      "visible": {
        "$state": "/mo",
        "not": true
      }
    },
    "when": {
      "type": "Select",
      "props": {
        "label": "Send at",
        "value": {
          "$bindState": "/at"
        },
        "options": [
          "9am",
          "12pm",
          "6pm"
        ]
      }
    },
    "acts": {
      "type": "Row",
      "children": [
        "go"
      ]
    },
    "go": {
      "type": "Button",
      "props": {
        "label": "Schedule reminders",
        "variant": "primary"
      },
      "on": {
        "press": {
          "action": "scheduleReminders",
          "params": {
            "at": {
              "$state": "/at"
            }
          }
        }
      }
    }
  }
}
